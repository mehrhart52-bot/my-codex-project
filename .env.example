# Development only. Choose a unique local password and match it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://hta:replace-with-a-local-password@localhost:5432/hta
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Optional dedicated disposable test database. Tests refuse database names without _test.
TEST_DATABASE_URL=postgresql://hta:replace-with-a-local-password@localhost:5432/hta_test
# Optional: use a compatible preinstalled Chromium instead of downloading one.
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
